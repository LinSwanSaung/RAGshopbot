# Any OpenAI-compatible chat endpoint. Examples:
#
# Google AI Studio (free Gemma / Gemini):
#   LLM_API_KEY=AIzaSy...
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemma-4-26b-a4b-it
#
# OpenRouter (router across many providers):
#   LLM_API_KEY=sk-or-v1-...
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...

TELEGRAM_BOT_TOKEN=1234567890:ABC...   # from @BotFather (single-tenant dev only)

# Postgres connection for multi-tenant shop config (business_info table).
# On server: postgres://may_admin:may_secure_pass_2026@may_core_postgres:5432/may_core_db
SHOP_DB_URL=postgres://user:pass@host:5432/dbname

# Set to "production" to enable webhook mode (requires WEBHOOK_URL).
# Leave unset or "development" for long polling (local dev).
BOT_ENV=development
WEBHOOK_URL=https://13.229.238.234:8443/bot/webhook
